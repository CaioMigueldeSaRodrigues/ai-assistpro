{
  "name": "ai-agents-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/copy-migrations.mjs",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "npm run migrate && tsx --test --test-concurrency=1 test/mvp.test.ts"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "google-spreadsheet": "^4.1.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "pg": "^8.11.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
